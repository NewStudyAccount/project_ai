### 2.0 `<table>` <用途>

```sql
CREATE TABLE IF NOT EXISTS <table> (
  id BIGINT NOT NULL COMMENT '16 位发号',
  <字段> <类型> <NULL 约束> [DEFAULT ...] COMMENT '<说明>',
  create_time DATETIME NOT NULL COMMENT '创建时间',
  update_time DATETIME NOT NULL COMMENT '更新时间',
  create_by BIGINT NOT NULL COMMENT '创建人',
  update_by BIGINT NOT NULL COMMENT '更新人',
  deleted TINYINT NOT NULL DEFAULT 0 COMMENT '0 未删 / 1 已删',
  PRIMARY KEY (id),
  KEY idx_<table>_<field> (<field>),
  UNIQUE KEY uk_<table>_<field> (<field>)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='<用途>';
```

