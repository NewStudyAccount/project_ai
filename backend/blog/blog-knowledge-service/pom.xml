<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.qjj</groupId>
        <artifactId>blog-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>blog-knowledge-service</artifactId>
    <name>blog-knowledge-service</name>
    <description>blog 知识库业务模块（文档/切块/向量化/检索/RAG 问答；ES client 落点，CLAUDE.md 2.1 例外条款；blog-knowledge-base 提案）</description>

    <dependencies>
        <!-- 只读契约（ArticleContentProvider + DTO） -->
        <dependency>
            <groupId>com.qjj</groupId>
            <artifactId>blog-knowledge-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qjj</groupId>
            <artifactId>blog-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qjj</groupId>
            <artifactId>blog-framework</artifactId>
        </dependency>
        <!-- 手动导入源文上传（MinIO put） -->
        <dependency>
            <groupId>com.qjj</groupId>
            <artifactId>blog-object-storage</artifactId>
        </dependency>
        <!-- 检索引擎客户端（版本基线 docs/version-baseline.md；仅本模块引入） -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
